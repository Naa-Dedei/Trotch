# Copy to `.env` (PowerShell: Copy-Item .env.example .env) and fill in real values.
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone with the APK/IPA.
# NEVER put the Supabase service-role key, database password or any secret here.

# --- Supabase (leave both empty to run on the bundled DEMO network without accounts) ---
# Example values: https://abcdefghijklmnop.supabase.co and sb_publishable_xxxxxxxx
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the "anon" key also works.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# City whose network cache key is used (network data for all cities is loaded).
EXPO_PUBLIC_CITY_ID=accra
# Use the bundled DEMO network when Supabase is not configured (true/false).
EXPO_PUBLIC_ALLOW_DEMO_FALLBACK=true

# --- Place search outside the Trotch network (optional) ---
# none | nominatim | mapbox
EXPO_PUBLIC_GEOCODER=none
# For nominatim: your own instance or a provider; the public OSM server has a strict usage policy.
EXPO_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org
EXPO_PUBLIC_GEOCODER_CONTACT_EMAIL=you@example.com

# --- Street-level walking directions for walk legs (optional) ---
# none | osrm | mapbox
EXPO_PUBLIC_WALKING_PROVIDER=none
# OSRM-compatible server with a "foot" profile, e.g. https://routing.example.com
EXPO_PUBLIC_OSRM_URL=
# Mapbox public token (pk.*) — used if GEOCODER or WALKING_PROVIDER is "mapbox".
EXPO_PUBLIC_MAPBOX_TOKEN=

# --- Custom map tiles (optional; default is Google Maps on Android, Apple Maps on iOS) ---
# e.g. https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=

# --- Build-time only (read by app.config.ts, embedded in the native app, not in JS) ---
# Required for maps on Android (Maps SDK for Android). Gradle reads it when it builds, so after
# changing it just rebuild in Android Studio. It can also go in android/local.properties.
# Without it the app still runs; map areas are blank.
GOOGLE_MAPS_ANDROID_API_KEY=
# Only needed if you switch iOS to Google Maps; Apple Maps needs no key.
GOOGLE_MAPS_IOS_API_KEY=
TROTCH_ANDROID_PACKAGE=com.realfin.trotch
TROTCH_IOS_BUNDLE_ID=com.realfin.trotch
EAS_PROJECT_ID=

# --- Supabase CLI only (local `supabase start`), never used by the app ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
